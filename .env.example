# ────────────────────────────────────────────────────────────────
# LifeLog — environment configuration
# Copy this file to `.env` and adjust values.
# ────────────────────────────────────────────────────────────────

# Postgres (container-internal port stays 5432; host-exposed port is 5433
# because 5432 is already taken by the local PostgreSQL installation).
POSTGRES_USER=lifelog
POSTGRES_PASSWORD=lifelog
POSTGRES_DB=lifelog

# Backend reaches Postgres over the docker-compose network on 5432.
# If you run the backend OUTSIDE docker (on the host), use:
#   postgresql+asyncpg://lifelog:lifelog@localhost:5433/lifelog
DATABASE_URL=postgresql+asyncpg://lifelog:lifelog@postgres:5432/lifelog

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Client-side PBKDF2 iterations (kept in env so frontend and backend agree).
PBKDF2_ITERATIONS=100000

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
