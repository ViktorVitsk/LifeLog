# ────────────────────────────────────────────────────────────────
# LifeLog — environment configuration
# Copy this file to `.env` and adjust values.
# ────────────────────────────────────────────────────────────────

# Postgres (container-internal port stays 5432; host-exposed port is 5433
# to avoid conflicts with a host PostgreSQL installation).
POSTGRES_USER=lifelog
POSTGRES_PASSWORD=lifelog
POSTGRES_DB=lifelog

# Backend reaches Postgres over the docker-compose network on 5432.
# If you run the backend OUTSIDE docker (on the host), use:
#   postgresql+asyncpg://lifelog:lifelog@localhost:5433/lifelog
DATABASE_URL=postgresql+asyncpg://lifelog:lifelog@postgres:5432/lifelog

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_ABSOLUTE_EXPIRE_MINUTES=43200
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300

# Legacy server config; client KDF v1 is fixed at 100,000 in code.
# Changing this value does not migrate encryption keys.
PBKDF2_ITERATIONS=100000

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend: leave VITE_API_URL empty so the browser calls `/api` on :5173
# and Vite proxies to the local LifeLog backend.
VITE_API_URL=
# Host-side `npm run dev` proxies to this; docker-compose overrides to http://backend:8000
VITE_API_PROXY=http://localhost:8001
